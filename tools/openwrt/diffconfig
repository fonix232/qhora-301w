# Seed for src/openwrt/.config (tools/build-openwrt.sh expands it with
# `make defconfig`): qualcommax/ipq807x, both 301w profiles, each with its
# default package set, plus initramfs kernels (the ubootmod -recovery.itb).
# Add CONFIG_PACKAGE_<name>=y lines here to put more packages in the images.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_qnap_301w=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_qnap_301w-ubootmod=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
