From d4dc32f258bce4e1bc65a20e56da1a56d3a5d79a Mon Sep 17 00:00:00 2001
From: Jozsef Kiraly <fonix232@gmail.com>
Date: Sun, 27 Sep 2026 04:33:11 +0100
Subject: [PATCH 1/9] clk: qcom: add IPQ8074 GCC driver

Add a minimal Global Clock Controller driver for the IPQ8074 family,
covering the clocks and resets U-Boot needs for the console UART
(BLSP1 UART5), the SPI-NOR controller (BLSP1 QUP1) and eMMC (SDCC1).

Register offsets and frequency tables follow Linux
drivers/clk/qcom/gcc-ipq8074.c. The PLLs are left as the previous boot
stage configured them, as QCA's own U-Boot does.
---
 drivers/clk/qcom/Kconfig         |   9 ++
 drivers/clk/qcom/Makefile        |   1 +
 drivers/clk/qcom/clock-ipq8074.c | 160 +++++++++++++++++++++++++++++++
 3 files changed, 170 insertions(+)
 create mode 100644 drivers/clk/qcom/clock-ipq8074.c

diff --git a/drivers/clk/qcom/Kconfig b/drivers/clk/qcom/Kconfig
index 9ad233c83a..cd49220dc6 100644
--- a/drivers/clk/qcom/Kconfig
+++ b/drivers/clk/qcom/Kconfig
@@ -39,6 +39,15 @@ config CLK_QCOM_IPQ5424
 	  on the Qualcomm IPQ5424 SoC. This driver supports the clocks
 	  and resets exposed by the GCC hardware block.
 
+config CLK_QCOM_IPQ8074
+	bool "Qualcomm IPQ8074 GCC"
+	select CLK_QCOM
+	help
+	  Say Y here to enable support for the Global Clock Controller
+	  on the Qualcomm IPQ8074 SoC family (IPQ8070/8071/8072/8074/8076/8078).
+	  This driver supports the clocks and resets exposed by the GCC
+	  hardware block that U-Boot needs for UART, SPI and eMMC.
+
 config CLK_QCOM_IPQ9574
 	bool "Qualcomm IPQ9574 GCC"
 	select CLK_QCOM
diff --git a/drivers/clk/qcom/Makefile b/drivers/clk/qcom/Makefile
index c0d95a6300..406e999a4a 100644
--- a/drivers/clk/qcom/Makefile
+++ b/drivers/clk/qcom/Makefile
@@ -8,6 +8,7 @@ obj-$(CONFIG_CLK_QCOM_APQ8016) += clock-apq8016.o
 obj-$(CONFIG_CLK_QCOM_APQ8096) += clock-apq8096.o
 obj-$(CONFIG_CLK_QCOM_IPQ4019) += clock-ipq4019.o
 obj-$(CONFIG_CLK_QCOM_IPQ5424) += clock-ipq5424.o
+obj-$(CONFIG_CLK_QCOM_IPQ8074) += clock-ipq8074.o
 obj-$(CONFIG_CLK_QCOM_IPQ9574) += clock-ipq9574.o
 obj-$(CONFIG_CLK_QCOM_MILOS) += clock-milos.o
 obj-$(CONFIG_CLK_QCOM_QCM2290) += clock-qcm2290.o
diff --git a/drivers/clk/qcom/clock-ipq8074.c b/drivers/clk/qcom/clock-ipq8074.c
new file mode 100644
index 0000000000..d26f7e15dc
--- /dev/null
+++ b/drivers/clk/qcom/clock-ipq8074.c
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Clock driver for the Qualcomm IPQ8074 Global Clock Controller
+ *
+ * Register offsets and frequency tables follow Linux
+ * drivers/clk/qcom/gcc-ipq8074.c. Only the clocks U-Boot needs are
+ * described; the PLLs (GPLL0, GPLL2) are left as the previous boot
+ * stage configured them, as QCA's own U-Boot does.
+ */
+
+#include <linux/types.h>
+#include <clk-uclass.h>
+#include <dm.h>
+#include <linux/bitops.h>
+#include <dt-bindings/clock/qcom,gcc-ipq8074.h>
+
+#include "clock-qcom.h"
+
+/* RCG source selection values, from Linux's IPQ8074 parent maps */
+#define SRC_XO			(0 << 8)
+#define SRC_GPLL0		(1 << 8)
+#define SRC_GPLL2		(2 << 8)
+#define SRC_GPLL0_DIV2		(4 << 8)
+
+#define BLSP1_QUP1_SPI_APPS_CMD_RCGR	0x02024
+#define BLSP1_UART5_APPS_CMD_RCGR	0x06034
+#define SDCC1_APPS_CMD_RCGR		0x42004
+
+static const struct freq_tbl ftbl_blsp1_qup_spi_apps_clk_src[] = {
+	F(960000, SRC_XO, 10, 1, 2),
+	F(4800000, SRC_XO, 4, 0, 0),
+	F(9600000, SRC_XO, 2, 0, 0),
+	F(12500000, SRC_GPLL0_DIV2, 16, 1, 2),
+	F(16000000, SRC_GPLL0, 10, 1, 5),
+	F(19200000, SRC_XO, 1, 0, 0),
+	F(25000000, SRC_GPLL0, 16, 1, 2),
+	F(50000000, SRC_GPLL0, 16, 0, 0),
+	{ }
+};
+
+static const struct freq_tbl ftbl_blsp1_uart_apps_clk_src[] = {
+	F(3686400, SRC_GPLL0_DIV2, 1, 144, 15625),
+	F(7372800, SRC_GPLL0_DIV2, 1, 288, 15625),
+	F(14745600, SRC_GPLL0_DIV2, 1, 576, 15625),
+	F(16000000, SRC_GPLL0_DIV2, 5, 1, 5),
+	F(19200000, SRC_XO, 1, 0, 0),
+	F(24000000, SRC_GPLL0, 1, 3, 100),
+	F(25000000, SRC_GPLL0, 16, 1, 2),
+	F(32000000, SRC_GPLL0, 1, 1, 25),
+	F(40000000, SRC_GPLL0, 1, 1, 20),
+	F(46400000, SRC_GPLL0, 1, 29, 500),
+	F(48000000, SRC_GPLL0, 1, 3, 50),
+	F(51200000, SRC_GPLL0, 1, 8, 125),
+	F(56000000, SRC_GPLL0, 1, 7, 100),
+	F(58982400, SRC_GPLL0, 1, 1152, 15625),
+	F(60000000, SRC_GPLL0, 1, 3, 40),
+	F(64000000, SRC_GPLL0, 12.5, 1, 1),
+	{ }
+};
+
+static const struct freq_tbl ftbl_sdcc_apps_clk_src[] = {
+	F(144000, SRC_XO, 16, 3, 25),
+	F(400000, SRC_XO, 12, 1, 4),
+	F(24000000, SRC_GPLL2, 12, 1, 4),
+	F(48000000, SRC_GPLL2, 12, 1, 2),
+	F(96000000, SRC_GPLL2, 12, 0, 0),
+	F(177777778, SRC_GPLL0, 4.5, 0, 0),
+	F(192000000, SRC_GPLL2, 6, 0, 0),
+	F(384000000, SRC_GPLL2, 3, 0, 0),
+	{ }
+};
+
+static ulong ipq8074_set_rate(struct clk *clk, ulong rate)
+{
+	struct msm_clk_priv *priv = dev_get_priv(clk->dev);
+	const struct freq_tbl *freq;
+
+	switch (clk->id) {
+	case GCC_BLSP1_QUP1_SPI_APPS_CLK:
+		freq = qcom_find_freq(ftbl_blsp1_qup_spi_apps_clk_src, rate);
+		clk_rcg_set_rate_mnd(priv->base, BLSP1_QUP1_SPI_APPS_CMD_RCGR,
+				     freq->pre_div, freq->m, freq->n, freq->src, 8);
+		return freq->freq;
+	case GCC_BLSP1_UART5_APPS_CLK:
+		freq = qcom_find_freq(ftbl_blsp1_uart_apps_clk_src, rate);
+		clk_rcg_set_rate_mnd(priv->base, BLSP1_UART5_APPS_CMD_RCGR,
+				     freq->pre_div, freq->m, freq->n, freq->src, 16);
+		return freq->freq;
+	case GCC_SDCC1_APPS_CLK:
+		freq = qcom_find_freq(ftbl_sdcc_apps_clk_src, rate);
+		clk_rcg_set_rate_mnd(priv->base, SDCC1_APPS_CMD_RCGR,
+				     freq->pre_div, freq->m, freq->n, freq->src, 8);
+		return freq->freq;
+	default:
+		return 0;
+	}
+}
+
+static const struct gate_clk ipq8074_clks[] = {
+	GATE_CLK_POLLED(GCC_BLSP1_AHB_CLK, 0x01008, BIT(0), 0x01008),
+	GATE_CLK_POLLED(GCC_BLSP1_QUP1_SPI_APPS_CLK, 0x02004, BIT(0), 0x02004),
+	GATE_CLK_POLLED(GCC_BLSP1_UART5_APPS_CLK, 0x0602c, BIT(0), 0x0602c),
+	GATE_CLK_POLLED(GCC_SDCC1_APPS_CLK, 0x42018, BIT(0), 0x42018),
+	GATE_CLK_POLLED(GCC_SDCC1_AHB_CLK, 0x4201c, BIT(0), 0x4201c),
+};
+
+static int ipq8074_enable(struct clk *clk)
+{
+	struct msm_clk_priv *priv = dev_get_priv(clk->dev);
+
+	return qcom_gate_clk_en(priv, clk->id);
+}
+
+static const struct qcom_reset_map ipq8074_gcc_resets[] = {
+	[GCC_BLSP1_BCR] = { 0x01000 },
+	[GCC_BLSP1_QUP1_BCR] = { 0x02000 },
+	[GCC_SDCC1_BCR] = { 0x42000 },
+};
+
+static const phys_addr_t ipq8074_rcg_addrs[] = {
+	BLSP1_QUP1_SPI_APPS_CMD_RCGR,
+	BLSP1_UART5_APPS_CMD_RCGR,
+	SDCC1_APPS_CMD_RCGR,
+};
+
+static const char *const ipq8074_rcg_names[] = {
+	"BLSP1_QUP1_SPI_APPS",
+	"BLSP1_UART5_APPS",
+	"SDCC1_APPS",
+};
+
+static struct msm_clk_data ipq8074_gcc_data = {
+	.resets = ipq8074_gcc_resets,
+	.num_resets = ARRAY_SIZE(ipq8074_gcc_resets),
+	.clks = ipq8074_clks,
+	.num_clks = ARRAY_SIZE(ipq8074_clks),
+
+	.enable = ipq8074_enable,
+	.set_rate = ipq8074_set_rate,
+
+	.dbg_rcg_addrs = ipq8074_rcg_addrs,
+	.num_rcgs = ARRAY_SIZE(ipq8074_rcg_addrs),
+	.dbg_rcg_names = ipq8074_rcg_names,
+};
+
+static const struct udevice_id gcc_ipq8074_of_match[] = {
+	{
+		.compatible = "qcom,gcc-ipq8074",
+		.data = (ulong)&ipq8074_gcc_data,
+	},
+	{ }
+};
+
+U_BOOT_DRIVER(gcc_ipq8074) = {
+	.name		= "gcc_ipq8074",
+	.id		= UCLASS_NOP,
+	.of_match	= gcc_ipq8074_of_match,
+	.bind		= qcom_cc_bind,
+	.flags		= DM_FLAG_PRE_RELOC | DM_FLAG_DEFAULT_PD_CTRL_OFF,
+};
