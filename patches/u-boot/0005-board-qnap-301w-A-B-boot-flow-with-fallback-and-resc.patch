index caed012f9a..6b7fe19aac 100644
--- a/arch/arm/dts/ipq8072-qnap-301w-u-boot.dtsi
+++ b/arch/arm/dts/ipq8072-qnap-301w-u-boot.dtsi
@@ -12,3 +12,16 @@
 	sdhci-caps-mask = <0x0 0x04000000>;
 	sdhci-caps = <0x0 0x04000000>;	/* SDHCI_CAN_VDD_180 */
 };
+
+/ {
+	config {
+		/*
+		 * Environment lives in the "ubootenv" GPT partition (layout v2).
+		 * With CONFIG_ENV_MMC_USE_DT and no u-boot,mmc-env-offset here,
+		 * a missing partition makes env load/save fail instead of
+		 * falling back to a raw offset on the eMMC: on the stock layout
+		 * saveenv writes nothing.
+		 */
+		u-boot,mmc-env-partition = "ubootenv";
+	};
+};
diff --git a/board/qnap/301w/301w.c b/board/qnap/301w/301w.c
new file mode 100644
index 0000000000..3c601347ea
--- /dev/null
+++ b/board/qnap/301w/301w.c
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * QNAP QHora-301W
+ *
+ * The kernel device tree carries one phandle per firmware slot under
+ * /chosen (rootdisk-a, rootdisk-b), each pointing at that slot's eMMC
+ * partition. The boot scripts set "boot_rootdisk" to the property of the
+ * slot being booted; copy it to /chosen/rootdisk, which the kernel's fitblk
+ * driver uses to find the root filesystem inside the slot's FIT image.
+ * Same approach as OpenWrt's uboot-mediatek "select-rootdisk" patches.
+ */
+
+#include <env.h>
+#include <fdt_support.h>
+#include <linux/libfdt.h>
+
+int ft_system_setup(void *blob, struct bd_info *bd)
+{
+	const char *prop = env_get("boot_rootdisk");
+	const fdt32_t *phandle;
+	int chosen, len, ret;
+
+	if (!prop || !*prop)
+		return 0;
+
+	chosen = fdt_path_offset(blob, "/chosen");
+	if (chosen < 0)
+		return 0;
+
+	phandle = fdt_getprop(blob, chosen, prop, &len);
+	if (!phandle || len != sizeof(*phandle)) {
+		printf("rootdisk: /chosen/%s not in the kernel device tree\n", prop);
+		return 0;
+	}
+
+	ret = fdt_setprop(blob, chosen, "rootdisk", phandle, sizeof(*phandle));
+	if (ret)
+		printf("rootdisk: cannot set /chosen/rootdisk: %s\n", fdt_strerror(ret));
+	else
+		printf("rootdisk: /chosen/rootdisk = %s (phandle %#x)\n", prop,
+		       fdt32_to_cpu(*phandle));
+
+	return 0;
+}
diff --git a/board/qnap/301w/301w.env b/board/qnap/301w/301w.env
new file mode 100644
index 0000000000..4978e7442f
--- /dev/null
+++ b/board/qnap/301w/301w.env
@@ -0,0 +1,66 @@
+/*
+ * Boot flow for the QNAP QHora-301W: A/B firmware slots with fallback,
+ * then USB, then TFTP. See qhora-301w docs/design.md, "Recovery and
+ * fallback chain".
+ *
+ *   level 4: a slot that doesn't come up bootlimit times -> altbootcmd
+ *            switches to the other slot; if that happens again -> rescue
+ *   level 3: the active slot is missing or fails verification -> other slot
+ *   level 2: no bootable slot -> rescue (USB, then TFTP), retried forever
+ *   reset button held at power-on -> rescue
+ *
+ * OpenWrt's boot-ok service clears bootcount (and boot_fallback) once the
+ * system is up. Every name starting with qh_ is internal to these scripts.
+ */
+
+bootdelay=2
+bootlimit=3
+upgrade_available=1
+boot_slot=a
+bootconf=config@hk01
+loadaddr=0x44000000
+ipaddr=192.168.1.1
+serverip=192.168.1.254
+bootfile=openwrt-qualcommax-ipq807x-qnap_301w-ubootmod-initramfs-recovery.itb
+
+/* the block device the slots live on, and the button that forces rescue */
+qh_if=mmc
+qh_dev=0
+qh_btn=reset
+/* LEDs: red status while trying a slot, blinking red while in rescue.
+ * Always succeed: a missing LED must never stop a boot. */
+qh_led_try=led red:status on; true
+qh_led_ok=led red:status off; led green:status on; true
+qh_led_rescue=led green:status off; led red:status blink 250; true
+
+bootcmd=run qh_boot
+altbootcmd=run qh_limit
+
+qh_boot=if button ${qh_btn}; then echo "qh: reset button held, rescue"; run qh_rescue_loop; fi; run qh_slots; run qh_rescue_loop
+
+/* level 4: this slot failed to come up bootlimit times */
+qh_limit=if test "${boot_fallback}" = 1; then echo "qh: fallback slot failed too, rescue"; run qh_rescue_loop; fi; setenv qh_s ${boot_slot}; run qh_toggle; echo "qh: slot ${boot_slot} keeps failing, switching to ${qh_s}"; setenv boot_slot ${qh_s}; setenv boot_fallback 1; setenv bootcount 0; saveenv; run qh_slots; run qh_rescue_loop
+
+/* levels 3 and 2: the active slot, then the other one */
+qh_slots=setenv qh_s ${boot_slot}; run qh_try; run qh_toggle; echo "qh: slot ${boot_slot} not bootable, trying ${qh_s}"; run qh_try
+qh_toggle=if test "${qh_s}" = a; then setenv qh_s b; else setenv qh_s a; fi
+
+/* read exactly one FIT from partition fit_<slot>, verify all hashes, boot */
+qh_try=run qh_led_try; read ${qh_if} ${qh_dev}#fit_${qh_s} ${loadaddr} 0 0x100 && imszb ${loadaddr} qh_blocks && part size ${qh_if} ${qh_dev} fit_${qh_s} qh_size && test 0x${qh_blocks} -le 0x${qh_size} && read ${qh_if} ${qh_dev}#fit_${qh_s} ${loadaddr} 0 ${qh_blocks} && iminfo ${loadaddr} && run qh_commit && run qh_led_ok && setenv boot_rootdisk rootdisk-${qh_s} && run qh_do_boot
+/* booting the other slot than the active one makes it the active one */
+qh_commit=if test "${qh_s}" != "${boot_slot}"; then setenv boot_slot ${qh_s}; setenv boot_fallback 1; saveenv; fi; true
+qh_do_boot=bootm ${loadaddr}#${bootconf}
+
+/* rescue: an OpenWrt initramfs FIT from USB (first partition) or TFTP */
+qh_rescue=run qh_led_rescue; run qh_usb; run qh_tftp
+qh_rescue_loop=while true; do run qh_rescue; echo "qh: no rescue image, retrying"; sleep 5; done
+qh_usb=usb start && load usb 0:1 ${loadaddr} ${bootfile} && iminfo ${loadaddr} && setenv boot_rootdisk && run qh_do_boot
+qh_tftp=tftpboot ${loadaddr} ${bootfile} && iminfo ${loadaddr} && setenv boot_rootdisk && run qh_do_boot
+
+bootmenu_0=Boot the active slot=run qh_slots
+bootmenu_1=Boot slot A=setenv qh_s a; run qh_try
+bootmenu_2=Boot slot B=setenv qh_s b; run qh_try
+bootmenu_3=Rescue: USB, then TFTP (once)=run qh_rescue
+bootmenu_4=Make slot A active and save=setenv boot_slot a; setenv boot_fallback 0; setenv bootcount 0; saveenv
+bootmenu_5=Make slot B active and save=setenv boot_slot b; setenv boot_fallback 0; setenv bootcount 0; saveenv
+bootmenu_6=Reboot=reset
