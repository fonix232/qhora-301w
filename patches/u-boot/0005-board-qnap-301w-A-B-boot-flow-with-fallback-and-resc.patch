 arch/arm/dts/ipq8072-qnap-301w-u-boot.dtsi | 13 +++++
 board/qnap/301w/301w.c                     | 44 +++++++++++++++
 board/qnap/301w/301w.env                   | 66 ++++++++++++++++++++++
 board/qnap/301w/MAINTAINERS                |  6 ++
 board/qnap/301w/Makefile                   |  3 +
 configs/qnap_301w_defconfig                | 15 +++++
 6 files changed, 147 insertions(+)
 create mode 100644 board/qnap/301w/301w.c
 create mode 100644 board/qnap/301w/301w.env
 create mode 100644 board/qnap/301w/MAINTAINERS
 create mode 100644 board/qnap/301w/Makefile

