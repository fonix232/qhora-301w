new file mode 100644
index 0000000000..dfa538b5e6
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq8072-301w-ubootmod.dts
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq8072-301w.dtsi"
+
+/ {
+	model = "QNAP 301w (OpenWrt U-Boot layout)";
+	compatible = "qnap,301w-ubootmod", "qcom,ipq8074";
+
+	chosen {
+		bootargs-append = " root=/dev/fit0 rootwait";
+		/*
+		 * The OpenWrt U-Boot copies the phandle of the slot it booted
+		 * (rootdisk-a or rootdisk-b) to /chosen/rootdisk for fitblk.
+		 */
+		rootdisk-a = <&emmc_fit_a>;
+		rootdisk-b = <&emmc_fit_b>;
+	};
+};
+
+&sdhc_1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	card@0 {
+		compatible = "mmc-card";
+		reg = <0>;
+
+		block {
+			compatible = "block-device";
+
+			partitions {
+				emmc_fit_a: block-partition-fit-a {
+					partname = "fit_a";
+				};
+
+				emmc_fit_b: block-partition-fit-b {
+					partname = "fit_b";
+				};
+			};
+		};
+	};
+};
diff --git a/target/linux/qualcommax/image/ipq807x.mk b/target/linux/qualcommax/image/ipq807x.mk
index 72c1e57103..d46aa8cd08 100644
--- a/target/linux/qualcommax/image/ipq807x.mk
+++ b/target/linux/qualcommax/image/ipq807x.mk
@@ -452,6 +452,26 @@ define Device/qnap_301w
 endef
 TARGET_DEVICES += qnap_301w
 
+define Device/qnap_301w-ubootmod
+	DEVICE_VENDOR := QNAP
+	DEVICE_MODEL := 301w
+	DEVICE_VARIANT := (OpenWrt U-Boot layout)
+	DEVICE_DTS := ipq8072-301w-ubootmod
+	DEVICE_DTS_CONFIG := config@hk01
+	SOC := ipq8072
+	KERNEL := kernel-bin | libdeflate-gzip
+	KERNEL_INITRAMFS := kernel-bin | lzma | \
+		fit lzma $$(KDIR)/image-$$(firstword $$(DEVICE_DTS)).dtb with-initrd | pad-to 64k
+	KERNEL_INITRAMFS_SUFFIX := -recovery.itb
+	IMAGES := sysupgrade.itb
+	IMAGE_SIZE := 114688k
+	IMAGE/sysupgrade.itb := append-kernel | \
+		fit gzip $$(KDIR)/image-$$(firstword $$(DEVICE_DTS)).dtb external-static-with-rootfs | \
+		check-size | append-metadata
+	DEVICE_PACKAGES := fitblk kmod-fs-f2fs f2fs-tools ipq-wifi-qnap_301w
+endef
+TARGET_DEVICES += qnap_301w-ubootmod
+
 define Device/redmi_ax6
 	$(call Device/xiaomi_ax3600)
 	DEVICE_VENDOR := Redmi
