diff --git a/target/linux/qualcommax/ipq807x/base-files/etc/init.d/bootcount b/target/linux/qualcommax/ipq807x/base-files/etc/init.d/bootcount
index e7c20493b6..7daffdaabb 100755
--- a/target/linux/qualcommax/ipq807x/base-files/etc/init.d/bootcount
+++ b/target/linux/qualcommax/ipq807x/base-files/etc/init.d/bootcount
@@ -21,5 +21,15 @@ boot() {
 	netgear,wax630)
 		fw_setenv boot_count 0
 	;;
+	qnap,301w-ubootmod)
+		# End of boot reached: tell U-Boot this slot works, so its boot
+		# counter doesn't switch to the other slot.
+		. /lib/upgrade/common.sh
+		[ "$(rootfs_type)" = "tmpfs" ] && return 0
+		fw_setenv -s - <<-EOF
+			bootcount 0
+			boot_fallback 0
+		EOF
+	;;
 	esac
 }
diff --git a/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
index b9a25bc7b2..f3b542755b 100644
--- a/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq807x/base-files/lib/upgrade/platform.sh
@@ -146,6 +146,55 @@ linksys_mx_pre_upgrade() {
 	fi
 }
 
+# QNAP 301w in the OpenWrt U-Boot layout: two firmware slots (GPT fit_a and
+# fit_b), each holding a FIT and, after it, that slot's own overlay (fitblk
+# maps it as /dev/fitrw). Write the slot that isn't running, put the settings
+# into its overlay, then tell U-Boot to boot it. U-Boot verifies the slot
+# before booting and falls back to the other one, with its own untouched
+# overlay, if the new one doesn't come up (bootcount, bootlimit).
+qnap_301w_ab_upgrade() {
+	local current next
+
+	current="$(fw_printenv -n boot_slot 2>/dev/null)"
+	case "$current" in
+	a) next=b ;;
+	b) next=a ;;
+	*)
+		echo "boot_slot is '$current', expected a or b"
+		return 1
+		;;
+	esac
+
+	export EMMC_KERN_DEV="$(find_mmc_part "fit_$next")"
+	[ -n "$EMMC_KERN_DEV" ] || {
+		echo "cannot find partition fit_$next"
+		return 1
+	}
+	# settings go right after the FIT (emmc_copy_config), not elsewhere
+	unset EMMC_DATA_DEV EMMC_ROOT_DEV
+
+	echo "writing slot $next ($EMMC_KERN_DEV), running slot is $current"
+	emmc_do_upgrade "$1"
+	[ -n "$EMMC_KERNEL_BLOCKS" ] && [ "$EMMC_KERNEL_BLOCKS" -gt 0 ] || {
+		echo "writing slot $next failed"
+		return 1
+	}
+
+	# Settings: into the new slot's overlay area, right after the FIT.
+	# Without them, emmc_upgrade_fit has already cleared that area.
+	[ -n "$UPGRADE_BACKUP" ] && emmc_copy_config
+	sync
+
+	# Switch only after the slot and the settings are in place.
+	fw_setenv -s - <<-EOF || return 1
+		boot_slot $next
+		bootcount 0
+		boot_fallback 0
+		upgrade_available 1
+	EOF
+	echo "slot $next is now active"
+}
+
 platform_check_image() {
 	return 0;
 }
@@ -244,6 +293,9 @@ platform_do_upgrade() {
 		CI_ROOTPART="rootfs"
 		emmc_do_upgrade "$1"
 		;;
+	qnap,301w-ubootmod)
+		qnap_301w_ab_upgrade "$1"
+		;;
 	redmi,ax6|\
 	xiaomi,ax3600|\
 	xiaomi,ax9000)
