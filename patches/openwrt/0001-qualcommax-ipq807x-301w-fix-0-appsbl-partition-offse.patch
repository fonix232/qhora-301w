From 4e648da20cbcaa0bb545f0062b9655c4d06cf74f Mon Sep 17 00:00:00 2001
From: Jozsef Kiraly <fonix232@gmail.com>
Date: Sun, 27 Sep 2026 05:20:07 +0100
Subject: [PATCH 1/3] qualcommax: ipq807x: 301w: fix 0:appsbl partition offset

The 0:appsbl partition starts at 0x270000, right after 0:appsblenv, as
its node name and all neighbouring partitions say, but its reg started
at 0x250000. Linux exposed the environment plus the first 896 KiB of
U-Boot as 0:appsbl, and the last 128 KiB of the real partition
(0x350000-0x36ffff) as nothing at all, so a backup of 0:appsbl was not
a U-Boot image.

Fixes: 652d72260d81 ("qualcommax: 301w: provide AQR FW via NVMEM cells")
---
 target/linux/qualcommax/dts/ipq8072-301w.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/target/linux/qualcommax/dts/ipq8072-301w.dts b/target/linux/qualcommax/dts/ipq8072-301w.dts
index 50237b5e86..0dbfbe6a16 100644
--- a/target/linux/qualcommax/dts/ipq8072-301w.dts
+++ b/target/linux/qualcommax/dts/ipq8072-301w.dts
@@ -318,7 +318,7 @@
 
 			partition@270000 {
 				label = "0:appsbl";
-				reg = <0x250000 0x100000>;
+				reg = <0x270000 0x100000>;
 				read-only;
 			};
 
